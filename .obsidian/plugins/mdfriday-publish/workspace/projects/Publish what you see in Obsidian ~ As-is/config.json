{
  "baseURL": "/",
  "title": "Publish what you see in Obsidian ~ As-is",
  "contentDir": "content",
  "publishDir": "public",
  "defaultContentLanguage": "en",
  "taxonomies": {
    "tag": "tags",
    "category": "categories"
  },
  "module": {
    "imports": [
      {
        "path": "https://cdn.mdfriday.com/t/notes/1.0.2/pack.zip?version=1.0.2"
      }
    ]
  },
  "markdown": {
    "useInternalRenderer": true
  },
  "params": {
    "branding": true,
    "mdfriday": {
      "family": "notes",
      "variant": "paper",
      "version": "1.0.2"
    },
    "lastPublishUrl": ""
  },
  "publish": {
    "method": "cloudflare"
  },
  "languages": {
    "en": {
      "contentDir": "content",
      "weight": 1
    }
  }
}